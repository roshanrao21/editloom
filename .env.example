# Copy this file to .env for local overrides. Do not commit .env.
NODE_ENV=development
EDITLOOM_WEB_HOST=127.0.0.1
EDITLOOM_WEB_PORT=3000
EDITLOOM_API_HOST=127.0.0.1
EDITLOOM_API_PORT=3001
EDITLOOM_QUEUE_POLL_MS=1000
EDITLOOM_STORAGE_ROOT=.local-storage
DATABASE_URL=postgresql://editloom:editloom_dev_only@127.0.0.1:5432/editloom

# Future providers belong only in .env or the deployment secret store.
# EDITLOOM_OBJECT_STORAGE_ENDPOINT=
# EDITLOOM_TRANSCRIPTION_API_KEY=
